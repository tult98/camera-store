{
  "name": "core-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/core-api/src",
  "projectType": "application",
  "tags": ["scope:tools", "type:app"],
  "targets": {
    "build-cli": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/core-api",
        "main": "apps/core-api/src/index.ts",
        "tsConfig": "apps/core-api/tsconfig.json",
        "assets": []
      }
    },
    "serve-cli": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/core-api/src/index.js"
      },
      "dependsOn": ["build-cli"]
    },
    "dev-cli": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node apps/core-api/src/index.ts"
      }
    },
    "cli": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/core-api/src/index.js"
      },
      "dependsOn": ["build"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/core-api",
        "command": "nest start --watch"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/core-api",
        "command": "nest build"
      },
      "dependsOn": ["prisma:generate"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/core-api",
        "command": "nest start"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/core-api/tsconfig.json"
      }
    },
    "prisma:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/core-api && npx prisma generate"
      }
    },
    "prisma:pull": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/core-api && npx prisma db pull"
      }
    },
    "prisma:studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/core-api && npx prisma studio"
      }
    },
    "prisma:format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/core-api && npx prisma format"
      }
    }
  }
}
