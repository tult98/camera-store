{
  "name": "product-crawler",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/product-crawler/src",
  "projectType": "application",
  "tags": ["scope:tools", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/product-crawler",
        "main": "apps/product-crawler/src/index.ts",
        "tsConfig": "apps/product-crawler/tsconfig.json",
        "assets": []
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/product-crawler/src/index.js"
      },
      "dependsOn": ["build"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node apps/product-crawler/src/index.ts"
      }
    },
    "cli": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/product-crawler/src/index.js"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/product-crawler/tsconfig.json"
      }
    }
  }
}
