# API Authentication
API_KEY=your-secret-api-key-here
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-refresh-token-secret-must-be-different-from-access

# S3 Configuration (MinIO-compatible)
S3_BUCKET=product-images
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FILE_URL=http://localhost:9000/product-images
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# Puppeteer Configuration
PUPPETEER_TIMEOUT=30000
PUPPETEER_HEADLESS=true

# Redis Configuration
REDIS_URL=redis://localhost:6379

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Shared with MedusaJS backend)
DATABASE_URL=postgresql://user:password@localhost:5432/database_name
